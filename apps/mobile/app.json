{
  "name": "boks",
  "slug": "boks",
  "version": "1.0.0",
  "orientation": "portrait",
  "scheme": "boks",
  "userInterfaceStyle": "light",
  "newArchEnabled": true,
  "splash": {
    "resizeMode": "contain",
    "backgroundColor": "#F9F8F3"
  },
  "ios": {
    "supportsTablet": true,
    "bundleIdentifier": "local.boks.app"
  },
  "android": {
    "adaptiveIcon": {
      "backgroundColor": "#1A4334"
    },
    "package": "local.boks.app"
  },
  "plugins": ["expo-router", "expo-secure-store"],
  "experiments": {
    "typedRoutes": true
  }
}
